# Copy to .env.local and fill in. .env.local is git-ignored.

# ElevenLabs API key — used by:
#   1. scripts/generate-audio.mjs (build-time voice clip generation)
#   2. /api/transcribe (runtime speech-to-text for iOS Safari, which lacks the Web Speech API)
# Get one at https://elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=sk_your_key_here

# Optional: the cloned "Joel" voice id used as the primary playback voice.
# Defaults to the built-in id if omitted.
ELEVENLABS_JOEL_VOICE_ID=OH0RKOa9ViI9M4CAHBcv

# OpenAI API key — used by /api/chat, the live conversation partner (/talk).
# Server-side secret (never exposed to the browser). Uses the gpt-4o-mini model.
# Get one at https://platform.openai.com → API keys. Without it, /talk shows an
# "almost ready" notice and the rest of the app is unaffected.
OPENAI_API_KEY=sk-your_key_here

# Supabase (optional — the app is local-first via IndexedDB and runs without it).
# When set, the data layer can sync to Supabase for cross-device / multi-student.
# The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Service role key (required server-only; NEVER prefix with NEXT_PUBLIC_). Used
# for durable API quotas and trusted admin/push operations, including writes to
# the RLS-locked push_subscriptions table. This key bypasses RLS: never expose it
# to browser code, logs, screenshots, support tickets, or source control.
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Shows the "Continue with Google" button on the login screen. Set to "true" ONLY
# after the Google provider is enabled in Supabase (Authentication -> Providers ->
# Google) and the callback URL is on the redirect allowlist. Left unset, the button
# is hidden — an OAuth redirect to an unconfigured provider dead-ends on a raw JSON
# error page the app cannot catch or style. Needed at BUILD time.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Azure AI Speech — phoneme-level pronunciation scoring (/api/assess). Without it,
# the app falls back to transcript-based scoring.
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# Azure OpenAI (optional) — when all three are set, /api/chat, /api/grade and
# /api/call-score use the Azure deployment instead of plain OpenAI.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_API_VERSION=2024-10-21   # optional; must support strict json_schema

# Web Push (daily reminders). VAPID public key is needed at BUILD time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Guards the daily-reminder cron (/api/push/send). The route fails closed without it.
CRON_SECRET=a_long_random_string

# Access control (audit P0: emails moved out of code — they are personal data
# and used to ship in the client bundle). Comma-separated. Server-only; with
# this unset in production, no non-admin passes the learner allowlist (fails
# closed), so set it before shipping. Admin capability is set only in the
# user's server-controlled Supabase raw app metadata (`clara_role: admin`).
ALLOWED_EMAILS=student1@example.com,student2@example.com
