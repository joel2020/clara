# Copy to .env.local and fill in. .env.local is git-ignored.

# ElevenLabs API key — used by:
#   1. scripts/generate-audio.mjs (build-time voice clip generation)
#   2. /api/transcribe (runtime speech-to-text for iOS Safari, which lacks the Web Speech API)
# Get one at https://elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=sk_your_key_here

# Optional: the cloned "Joel" voice id used as the primary playback voice.
# Defaults to the built-in id if omitted.
ELEVENLABS_JOEL_VOICE_ID=OH0RKOa9ViI9M4CAHBcv
